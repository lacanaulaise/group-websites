{
  // Pub La Canaulaise website — static Astro site + Worker for /api/*.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pub-lacanaulaise",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  // Keep variables and secrets set in the Cloudflare dashboard when deploying from GitHub.
  "keep_vars": true,
  // Public, non-secret settings live here (secrets stay in the Cloudflare dashboard):
  //   GOOGLE_PLACES_KEY, FORM_RELAY_URL, FORM_RELAY_SECRET, META_TOKEN (Facebook user token
  //   that can see the "Bière et Pub La Canaulaise" Page, for events and Instagram).
  "vars": {
    // @biere.lacanaulaise, linked to the Facebook Page
    "IG_USER_ID": "17841414626793223",
    // Tab EVENEMENTS LA CANAULAISE of "Carte site web" (tools/web_events.gs, hourly from the pub calendar)
    "EVENTS_CSV_URL": "https://docs.google.com/spreadsheets/d/e/2PACX-1vRRO1Z3SSvCM-4lIhzsdQXXCctkZupkQyUnrP6VwTyesFzqKSC5zBCF8DbWGAXPZXonURsmIVvRzE_-/pub?gid=2111933437&single=true&output=csv",
    // Tab LA CANAULAISE of "Carte site web" (tools/monora_web_menu.gs, daily from the till)
    "CARTE_CSV_URL": "https://docs.google.com/spreadsheets/d/e/2PACX-1vRRO1Z3SSvCM-4lIhzsdQXXCctkZupkQyUnrP6VwTyesFzqKSC5zBCF8DbWGAXPZXonURsmIVvRzE_-/pub?gid=2128228337&single=true&output=csv"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
