---
import '../styles/site.css';
import site from '../data/site.json';
import { T, path } from '../i18n.js';

interface Props { title: string; description: string; lang?: 'fr' | 'en'; page?: string; }
const { title, description, lang = 'fr', page = '/' } = Astro.props;
const t = T[lang];
const home = path(lang, '/');
const booking = site.bookingUrl || home + '#infos';
const otherHref = path(t.other, page);
---
<!doctype html>
<html lang={t.htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="alternate" hreflang="fr" href={path('fr', page)} />
  <link rel="alternate" hreflang="en" href={path('en', page)} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600&family=Roboto:wght@400;500;700&family=Satisfy&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href={home}><img src="/img/logo-sign-600.webp" alt="Pub La Canaulaise" width="200" height="44" /></a>
      <nav class="site-nav" aria-label={lang === 'en' ? 'Main navigation' : 'Navigation principale'}>
        <a href={home + '#ce-soir'}>{t.nav.tonight}</a>
        <a href={home + '#pression'}>{t.nav.draught}</a>
        <a href={path(lang, '/carte')}>{t.nav.menu}</a>
        <a href={home + '#evenements'}>{t.nav.events}</a>
        <a href={path(lang, '/privatisation')}>{t.nav.private}</a>
        <a href={home + '#infos'}>{t.nav.info}</a>
        <a class="lang" href={otherHref} hreflang={t.other} lang={t.other} aria-label={t.otherAria}>{t.otherLabel}</a>
        <a class="btn btn-brass" href={booking}>{t.nav.book}</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-top">
        <div>
          <strong>{t.footer.house}</strong>
          <div class="social">
            {site.instagramUrl && <a href={site.instagramUrl} target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1.1.4 2.2.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1.1.4-2.2.4-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1.1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1.1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.1 0-3.5 0-4.7.1-1.1.1-1.7.2-2.1.4-.5.2-.9.4-1.3.8-.4.4-.6.8-.8 1.3-.2.4-.3 1-.4 2.1C2.6 9.9 2.6 10.3 2.6 12s0 3.5.1 4.7c.1 1.1.2 1.7.4 2.1.2.5.4.9.8 1.3.4.4.8.6 1.3.8.4.2 1 .3 2.1.4 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1.1-.1 1.7-.2 2.1-.4.5-.2.9-.4 1.3-.8.4-.4.6-.8.8-1.3.2-.4.3-1 .4-2.1.1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c-.1-1.1-.2-1.7-.4-2.1-.2-.5-.4-.9-.8-1.3-.4-.4-.8-.6-1.3-.8-.4-.2-1-.3-2.1-.4C15.5 4 15.1 4 12 4zm0 3.1a4.9 4.9 0 110 9.8 4.9 4.9 0 010-9.8zm0 8a3.1 3.1 0 100-6.2 3.1 3.1 0 000 6.2zm6.2-8.2a1.2 1.2 0 11-2.4 0 1.2 1.2 0 012.4 0z"/></svg></a>}
            {site.facebookUrl && <a href={site.facebookUrl} target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21.9v-8h2.7l.4-3.1h-3.1v-2c0-.9.3-1.5 1.6-1.5h1.6V4.5c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.1v2.3H7.6v3.1h2.7v8z"/></svg></a>}
          </div>
        </div>
        <nav aria-label={t.footer.sistersAria}>
          {site.sisterVenues.map((v, i) => (v.url ? <a href={v.url}>{t.footer.sisters[i] || v.name}</a> : <span>{t.footer.sisters[i] || v.name}</span>))}
        </nav>
      </div>
      <div class="footer-bottom">
        <span>{t.footer.evin}</span>
        <span><a href="/mentions-legales" hreflang="fr">{t.footer.legal}</a><a href="/confidentialite" hreflang="fr">{t.footer.privacy}</a></span>
      </div>
    </div>
  </footer>
  <slot name="scripts" />
</body>
</html>
