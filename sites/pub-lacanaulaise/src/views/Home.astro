---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import beers from '../data/beers.json';
import galleryPhotos from '../data/gallery.json';
import { T, path } from '../i18n.js';

interface Props { lang: 'fr' | 'en'; }
const { lang } = Astro.props;
const t = T[lang];
const h = t.home;
const en = lang === 'en';

const fmtAbv = (n: number) => (en ? n.toFixed(1) : n.toFixed(1).replace('.', ',')) + ' %';
const eur = (c: number | null) => {
  if (c == null) return '';
  const v = c % 100 ? (c / 100).toFixed(2) : String(c / 100);
  return en ? '€' + v : v.replace('.', ',') + ' €';
};
const splitHour = (line: string) => {
  const i = line.indexOf(':');
  const day = line.slice(0, i).trim().toLowerCase();
  return { day: (h.days as Record<string, string>)[day] || day, time: line.slice(i + 1).trim() };
};
const hours = site.fallbackHours.map(splitHour);
const eventImgs = [
  { img: 'band', alt: en ? 'A band playing in the pub garden' : 'Un groupe en concert dans le jardin du pub' },
  { img: 'singer', alt: en ? 'A singer on the garden stage' : 'Un chanteur sur la scène du jardin' },
  { img: 'pints-live', alt: en ? 'Two La Canaulaise pints on a garden table' : 'Deux pintes La Canaulaise sur une table du jardin' },
  { img: 'terrace', alt: en ? 'The covered terrace set for a party' : 'La terrasse couverte dressée pour une soirée' },
];
const events = h.fallbackEvents.map((e, i) => ({ ...e, ...eventImgs[i] }));
const booking = site.bookingUrl || '#infos';
// Placeholder gallery from the 2025 photo shoot, until the Instagram feed replaces it.
const gallery = [
  { img: 'pints-live', alt: en ? 'Two La Canaulaise pints in the garden' : 'Deux pintes La Canaulaise dans le jardin' },
  { img: 'band', alt: en ? 'A band playing in the garden' : 'Un groupe en concert dans le jardin' },
  { img: 'tapas-board', alt: en ? 'A board of fried tapas and chips' : 'Une planche de tapas et de frites' },
  { img: 'garden-tables', alt: en ? 'Long tables set in the garden' : 'De grandes tablées dressées dans le jardin' },
  { img: 'singer', alt: en ? 'A singer on the garden stage' : 'Un chanteur sur la scène du jardin' },
  { img: 'skewers', alt: en ? 'Prawn skewers at a private party' : 'Brochettes de crevettes lors d’une soirée privée' },
];
// Text the page scripts need (plain JSON).
const S = {
  lang, locale: t.locale, mapQuery: site.mapQuery, today: h.today, tonightShort: h.tonightShort, allDay: h.allDay, allDayShort: h.allDayShort,
  next: h.next, cat: h.cat, instaAlt: h.instaAlt, instaAria: h.instaAria, mapTitle: h.mapTitle,
  nlOk: h.nlOk, nlBad: h.nlBad, nlFail: h.nlFail, hhPint: h.hhPint,
  open: h.open, openUntil: h.openUntil, closed: h.closed, closedOpens: h.closedOpens, closedToday: h.closedToday,
  titles: en ? { 'Fléchettes': 'Darts', 'Tournoi de fléchettes': 'Darts tournament' } : {},
  days: h.days, everyDay: h.everyDay, fromTo: h.fromTo, todayAt: h.todayAt, notToday: h.notToday,
};
---
<Base title={h.title} description={h.description} lang={lang} page="/">
    <section id="top" class="hero">
      <div class="wrap">
        <div class="hero-text">
          <img class="hero-logo" src="/img/logo-enseigne-360.webp" srcset="/img/logo-enseigne-360.webp 360w, /img/logo-enseigne-720.webp 720w" sizes="200px" alt={h.logoAlt} width="200" height="301" />
          <h1>{h.h1}</h1>
          <span class="hand">{h.since}</span>
          <p>{h.intro}</p>
          <div class="hero-actions">
            <a class="btn btn-brass" href={booking}>{h.bookTable}</a>
            <a class="btn btn-ghost" href={path(lang, '/carte')}>{h.seeMenu}</a>
            <a class="btn btn-ghost" href={path(lang, '/privatisation')}>{h.privatise}</a>
          </div>
        </div>
        <img class="hero-photo" src="/img/photos/hero.webp" alt={h.facadeAlt} width="1200" height="1500" fetchpriority="high" />
      </div>
    </section>

    <section id="ce-soir" class="tonight" aria-label={h.tonight}>
      <div class="wrap">
        <div class="item">
          <span class="label">{h.now}</span>
          <span class="value"><span class="dot" id="status-dot" aria-hidden="true"></span><span id="status-text">{h.nowDefault}</span></span>
        </div>
        <div class="item">
          <span class="label">{h.happyHour}</span>
          <span class="value" id="happy-hour">—</span>
        </div>
        <div class="item">
          <span class="label">{h.tonight}</span>
          <span class="value" id="tonight-event">{h.tonightDefault}</span>
        </div>
        <div class="item">
          <span class="label">{h.draught}</span>
          <a class="value" href="#pression">{beers.length} {h.taps} →</a>
        </div>
      </div>
    </section>

    <section id="pression" class="section">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2>{h.draught}</h2>
            <p>{h.draughtIntro}</p>
          </div>
        </div>
        <div class="beers">
          {beers.map((b) => (
            <article class="beer" data-beer={b.name}>
              {b.easybeerImg && <img class="beer-img" src={`/api/beer-img/${b.easybeerId}?u=${b.easybeerImg}`} alt="" width="64" height="64" loading="lazy" />}
              <h3>{b.name}</h3>
              <span class="style">{en ? b.styleEn : b.style}</span>
              {b.abv && <span class="meta">{fmtAbv(b.abv)}</span>}
              <dl class="prices">
                <div><dt>{h.half}</dt><dd data-fmt="25 cl">{eur(b.prices.demi)}</dd></div>
                <div><dt>{h.pint}</dt><dd data-fmt="50 cl">{eur(b.prices.pinte)}</dd></div>
                {b.prices.pichet && <div><dt>{h.jug}</dt><dd data-fmt="1,5 L">{eur(b.prices.pichet)}</dd></div>}
              </dl>
              {b.prices.pinteHH && <span class="hh" data-hh>{h.hhPint} {eur(b.prices.pinteHH)}</span>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="carte" class="section food">
      <div class="wrap split">
        <img class="food-photo" src="/img/photos/food.webp" alt={h.foodAlt} width="1000" height="800" loading="lazy" />
        <div class="food-text">
          <h2>{h.foodTitle}</h2>
          <p>{h.foodText}</p>
          <span><strong>{h.kitchen}</strong> <span id="kitchen-hours">—</span></span>
          <a class="btn btn-green" href={path(lang, '/carte')}>{h.fullMenu}</a>
        </div>
      </div>
    </section>

    <section id="jardin" class="section garden">
      <div class="wrap split">
        <div class="food-text">
          <h2>{h.gardenTitle}</h2>
          <p>{h.gardenText}</p>
          <a class="btn btn-green" href={path(lang, '/privatisation')}>{h.gardenCta}</a>
        </div>
        <img class="food-photo" src="/img/photos/garden.webp" alt={h.gardenAlt} width="1000" height="800" loading="lazy" />
      </div>
    </section>

    <section id="lieu" class="section">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2>{T[lang].place.title}</h2>
            <p>{T[lang].place.text}</p>
          </div>
          <a class="btn btn-green" href={path(lang, '/galerie')}>{T[lang].place.more}</a>
        </div>
        <div class="place-grid">
          {T[lang].place.spaces.map((sp) => {
            const ph = galleryPhotos.find((g) => g.slug === sp.slug);
            return (
              <a class="place-card" href={path(lang, '/galerie') + '#lieu'}>
                <img src={`/img/gallery/${sp.slug}-sm.webp`} alt={lang === 'en' ? ph.altEn : ph.alt} width={ph.tw} height={ph.th} loading="lazy" />
                <span>{sp.name}</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <section id="evenements" class="section events">
      <div class="wrap">
        <div class="section-head">
          <h2>{h.events}</h2>
        </div>
        <div class="event-grid" id="event-grid">
          {events.map((e) => (
            <article class="event">
              <img src={`/img/photos/${e.img}-card.webp`} alt={e.alt} width="640" height="400" loading="lazy" />
              <div class="event-body">
                <span class="event-date">{e.when}</span>
                <h3>{e.title}</h3>
                <p>{e.line}</p>
              </div>
            </article>
          ))}
        </div>
        <div class="agenda" id="agenda" hidden>
          <h3>{h.week}</h3>
          <div class="agenda-days"></div>
        </div>
      </div>
    </section>

    <section class="section" aria-label="Instagram">
      <div class="wrap">
        <div class="section-head">
          <h2>{h.insta}</h2>
          <a href={site.instagramUrl} target="_blank" rel="noopener">{h.follow}</a>
        </div>
        <div class="insta-grid" id="insta-grid">
          {gallery.map((g) => (
            <img src={`/img/photos/${g.img}-sq.webp`} alt={g.alt} width="500" height="500" loading="lazy" />
          ))}
        </div>
      </div>
    </section>

    <section id="infos" class="section visit">
      <div class="wrap split">
        <div>
          <h2>{h.find}</h2>
          <div class="contact">
            <span>{site.address}</span>
            <a href={`tel:${site.phoneIntl}`}><strong>{en ? site.phoneEn : site.phone}</strong></a>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </div>
          <table class="hours">
            <caption class="label">{h.hours}</caption>
            <tbody id="hours-body">
              {hours.map((x) => (
                <tr><th scope="row">{x.day}</th><td>{x.time}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="hours-extra" id="hours-extra"></p>
        </div>
        <div class="map" id="map">
          <img src="/img/photos/map-bg.webp" alt="" class="map-bg" loading="lazy" />
          <div class="map-cta">
            <strong>{site.mapLabel}</strong>
            <button type="button" id="map-load">{h.showMap}</button>
            <a href={site.mapsUrl} target="_blank" rel="noopener">{h.directions}</a>
            <small>{h.mapNote}</small>
          </div>
        </div>
      </div>
    </section>

    <section class="newsletter" aria-label="Newsletter">
      <form class="wrap" id="newsletter-form">
        <div class="intro">
          <h2>{h.nlTitle}</h2>
          <span>{h.nlSub}</span>
        </div>
        <div class="fields">
          <label>{h.nlLabel}
            <input type="email" name="email" placeholder={h.nlPlaceholder} autocomplete="email" />
          </label>
          <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="hidden" name="lang" value={lang} />
          <button type="submit">{h.nlButton}</button>
        </div>
        <p id="nl-status" role="status"></p>
      </form>
    </section>

  <script is:inline slot="scripts" define:vars={{ S }}>
    const EN = S.lang === 'en';
    const tz = { timeZone: 'Europe/Paris' };
    // "20:30" → "20h30" in French; kept as "20:30" in English.
    const hm = (t) => EN ? t : t.replace(/:00\b/g, 'h').replace(/(\d+):(\d\d)/g, '$1h$2');
    const euro = (n) => { const v = Number.isInteger(n) ? String(n) : n.toFixed(2); return EN ? '€' + v : v.replace('.', ',') + ' €'; };

    // Newsletter sign-up: the Worker validates the address and logs it (Sheet) until Brevo is set up.
    const nl = document.getElementById('newsletter-form');
    nl.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const status = document.getElementById('nl-status');
      const btn = nl.querySelector('button');
      btn.disabled = true;
      fetch('/api/newsletter', { method: 'POST', body: new FormData(nl) })
        .then((r) => r.json()).then((d) => {
          status.textContent = d.ok ? S.nlOk : (d.error === 'email' ? S.nlBad : S.nlFail);
          if (d.ok) nl.reset();
        })
        .catch(() => { status.textContent = S.nlFail; })
        .finally(() => { btn.disabled = false; });
    });

    // Events: from the pub's calendar (or Facebook later). Cards = one highlight per kind, then the week's agenda.
    fetch('/api/events').then((r) => r.ok ? r.json() : null).then((d) => {
      if (!d || !d.events || !d.events.length) return;
      const ymd = (dt) => dt.toLocaleDateString('en-CA', tz);
      const dayOf = (e) => e.date || ymd(new Date(e.start));
      const dayLabel = (s) => new Date(s + 'T12:00:00').toLocaleDateString(S.locale, { weekday: 'long', day: 'numeric', month: 'long' });
      const shortDay = (s) => new Date(s + 'T12:00:00').toLocaleDateString(S.locale, { weekday: 'short', day: 'numeric', month: 'short' });
      const hour = (e) => e.allDay ? '' : hm(e.time || new Date(e.start).toLocaleTimeString('fr-FR', { ...tz, hour: '2-digit', minute: '2-digit' }));
      const label = (e) => S.cat[e.category] || e.label || '';
      // Generic calendar titles get translated; match and event names stay as written.
      for (const e of d.events) e.name = S.titles[e.name] || e.name;
      const today = ymd(new Date());

      const tonight = d.events.filter((e) => dayOf(e) === today);
      const slot = document.getElementById('tonight-event');
      if (tonight.length) slot.textContent = tonight.slice(0, 2).map((e) => e.name + (hour(e) ? ' · ' + hour(e) : '')).join(' — ');
      else slot.textContent = S.next + ' ' + shortDay(dayOf(d.events[0])) + ' · ' + d.events[0].name;

      // Highlight cards: the next event of each kind, most special first.
      const order = ['soiree', 'concert', 'karaoke', 'tournoi', 'quiz', 'flechettes', 'rugby', 'foot', 'nfl', 'special'];
      const picks = [];
      for (const k of order) {
        const e = d.events.find((x) => x.category === k);
        if (e && picks.length < 4) picks.push(e);
      }
      picks.sort((a, b) => a.start.localeCompare(b.start));
      const grid = document.getElementById('event-grid');
      grid.textContent = '';
      for (const e of picks) {
        const card = document.createElement(e.url ? 'a' : 'article');
        card.className = 'event';
        if (e.url) { card.href = e.ticket || e.url; card.target = '_blank'; card.rel = 'noopener'; }
        const img = document.createElement('img');
        img.src = e.img || '/img/photos/interior-card.webp'; img.alt = ''; img.loading = 'lazy'; img.width = 640; img.height = 400;
        const body = document.createElement('div'); body.className = 'event-body';
        const when = document.createElement('span'); when.className = 'event-date';
        when.textContent = (dayOf(e) === today ? S.tonightShort : shortDay(dayOf(e))) + (hour(e) ? ' · ' + hour(e) : '');
        const h3 = document.createElement('h3'); h3.textContent = e.name;
        const p = document.createElement('p'); const l = label(e); p.textContent = l && l !== e.name ? l : '';
        body.append(when, h3, p); card.append(img, body); grid.appendChild(card);
      }

      // Agenda: everything in the next 7 days, by day.
      const limit = ymd(new Date(Date.now() + 7 * 864e5));
      const week = d.events.filter((e) => dayOf(e) <= limit);
      const box = document.getElementById('agenda');
      if (!week.length || !box) return;
      const days = new Map();
      for (const e of week) { if (!days.has(dayOf(e))) days.set(dayOf(e), []); days.get(dayOf(e)).push(e); }
      const list = box.querySelector('.agenda-days');
      for (const [day, items] of days) {
        const col = document.createElement('div'); col.className = 'agenda-day';
        const h4 = document.createElement('h4'); h4.textContent = day === today ? S.today : dayLabel(day);
        const ul = document.createElement('ul');
        for (const e of items) {
          const li = document.createElement('li');
          const tm = document.createElement('span'); tm.className = 'agenda-time'; tm.textContent = hour(e);
          const n = document.createElement('span'); n.className = 'agenda-name'; n.textContent = e.name;
          const tag = document.createElement('span'); tag.className = 'agenda-tag tag-' + e.category; tag.textContent = label(e);
          li.append(tm, n, tag); ul.appendChild(li);
        }
        col.append(h4, ul); list.appendChild(col);
      }
      box.hidden = false;
    }).catch(() => {});

    // Instagram: replace the shoot photos with the latest posts when the feed is available.
    fetch('/api/instagram').then((r) => r.ok ? r.json() : null).then((d) => {
      if (!d || !d.posts || d.posts.length < 3) return;
      const grid = document.getElementById('insta-grid');
      grid.textContent = '';
      for (const p of d.posts) {
        const a = document.createElement('a');
        a.href = p.permalink; a.target = '_blank'; a.rel = 'noopener';
        a.setAttribute('aria-label', S.instaAria + (p.caption ? ' : ' + p.caption : ''));
        const img = document.createElement('img');
        img.src = p.img; img.alt = p.caption || S.instaAlt;
        img.loading = 'lazy'; img.width = 500; img.height = 500;
        a.appendChild(img); grid.appendChild(a);
      }
    }).catch(() => {});

    // Draught prices: refresh from the live menu (till → Sheet) so they never drift.
    fetch('/api/carte').then((r) => r.json()).then((d) => {
      const sec = (d.sections || []).find((s) => s.title === 'Bières à la pression');
      if (!sec) return;
      for (const card of document.querySelectorAll('[data-beer]')) {
        const item = sec.items.find((i) => i.name === card.dataset.beer);
        if (!item) continue;
        for (const dd of card.querySelectorAll('[data-fmt]')) {
          const p = item.prices.find((x) => x.format === dd.dataset.fmt);
          if (p) dd.textContent = euro(p.price);
        }
        const pint = item.prices.find((x) => x.format === '50 cl');
        const hh = card.querySelector('[data-hh]');
        if (hh && pint && pint.hh != null && pint.hh < pint.price) hh.textContent = S.hhPint + ' ' + euro(pint.hh);
      }
    }).catch(() => {});

    document.getElementById('map-load')?.addEventListener('click', () => {
      const box = document.getElementById('map');
      const f = document.createElement('iframe');
      f.src = 'https://www.google.com/maps?q=' + S.mapQuery + '&z=16&output=embed&hl=' + S.lang;
      f.title = S.mapTitle;
      f.loading = 'lazy'; f.referrerPolicy = 'no-referrer-when-downgrade';
      box.replaceChildren(f);
    });

    // Hours (Google Business listing, French day names from the API).
    const parisDay = () => new Intl.DateTimeFormat('fr-FR', { weekday: 'long', timeZone: 'Europe/Paris' }).format(new Date()).toLowerCase();
    const DAYS = ['lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi', 'dimanche'];
    const dayName = (d) => S.days[d] || d;
    const span = (t) => hm(t.replace(/\s*[–-]\s*/, ' – '));
    // "lundi: Fermé · mardi: 17:00 – 19:00 …" → "17h – 19h, du mardi au dimanche" (or every day, or today's slot).
    function summarise(lines) {
      const byDay = {};
      for (const l of lines) {
        const i = l.indexOf(':');
        byDay[l.slice(0, i).trim().toLowerCase()] = l.slice(i + 1).trim();
      }
      const open = DAYS.filter((dn) => byDay[dn] && /\d/.test(byDay[dn]));
      const slots = [...new Set(open.map((dn) => byDay[dn]))];
      if (open.length && slots.length === 1) {
        const time = span(slots[0]);
        if (open.length === 7) return time + ', ' + S.everyDay;
        const first = DAYS.indexOf(open[0]), last = DAYS.indexOf(open[open.length - 1]);
        if (last - first + 1 === open.length) return time + ', ' + S.fromTo.replace('{a}', dayName(open[0])).replace('{b}', dayName(open[open.length - 1]));
        return time + ' (' + open.map(dayName).join(', ') + ')';
      }
      const today = byDay[parisDay()];
      if (today && /\d/.test(today)) return S.todayAt + ' ' + span(today);
      return today ? S.notToday : '—';
    }
    const split = (line) => {
      const i = line.indexOf(':');
      return { day: line.slice(0, i).trim().toLowerCase(), time: line.slice(i + 1).trim() };
    };
    const closedWord = (t) => EN ? t.replace(/Fermé/i, 'Closed').replace(/Ouvert 24h\/24/i, 'Open 24 hours') : t;

    fetch('/api/hours')
      .then((r) => r.json())
      .then((d) => {
        if (d.error) return;
        const lines = d.thisWeek?.length ? d.thisWeek : d.opening;
        const today = parisDay();
        const body = document.getElementById('hours-body');
        body.textContent = '';
        let todayTime = '';
        lines.map(split).forEach((x) => {
          const tr = document.createElement('tr');
          if (x.day === today) { tr.className = 'today'; todayTime = x.time; }
          const th = document.createElement('th'); th.scope = 'row'; th.textContent = dayName(x.day);
          const td = document.createElement('td'); td.textContent = closedWord(x.time);
          tr.append(th, td); body.appendChild(tr);
        });

        const dot = document.getElementById('status-dot');
        const text = document.getElementById('status-text');
        const [open, close] = todayTime.split('–').map((s) => s.trim());
        if (d.openNow === true) {
          dot.className = 'dot open';
          text.textContent = close ? S.openUntil + ' ' + hm(close) : S.open;
        } else if (d.openNow === false) {
          dot.className = 'dot closed';
          text.textContent = open && /\d/.test(open) ? S.closedOpens + ' ' + hm(open) : S.closedToday;
        }

        if (d.happyHour?.length) document.getElementById('happy-hour').textContent = summarise(d.happyHour);
        if (d.kitchen?.length) document.getElementById('kitchen-hours').textContent = summarise(d.kitchen);
      })
      .catch(() => {});
  </script>
</Base>
