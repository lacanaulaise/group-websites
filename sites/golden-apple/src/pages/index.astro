---
const title = 'The Golden Apple — Pub, Bordeaux';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <style>
      :root { --green: #1f3a2b; --brass: #c9a24b; --cream: #f4efe3; }
      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100vh; display: grid; place-items: center;
             background: var(--green); color: var(--cream);
             font-family: Georgia, 'Times New Roman', serif; text-align: center; padding: 2rem; }
      h1 { font-size: clamp(2.5rem, 8vw, 5rem); margin: 0 0 .25em; letter-spacing: .02em; }
      .since { color: var(--brass); text-transform: uppercase; letter-spacing: .3em; font-size: .85rem; }
      p { max-width: 32rem; margin: 1.5rem auto 0; line-height: 1.6; opacity: .85; }
      .tag { display: inline-block; margin-top: 2rem; padding: .4rem .9rem; border: 1px solid var(--brass);
             color: var(--brass); font-family: system-ui, sans-serif; font-size: .8rem; letter-spacing: .1em; }
    </style>
  </head>
  <body>
    <main>
      <div class="since">Bordeaux · depuis 1989</div>
      <h1>The Golden Apple</h1>
      <p>Nouveau site en construction. Le site actuel reste en ligne sur golden-apple.fr.</p>
      <span class="tag">PREVIEW</span>
    </main>
  </body>
</html>
