---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import beers from '../data/beers.json';

const fmtAbv = (n: number) => n.toFixed(1).replace('.', ',') + ' %';
const eur = (c: number | null) => c == null ? '' : (c % 100 ? (c / 100).toFixed(2).replace('.', ',') : String(c / 100)) + ' €';
const splitHour = (line: string) => {
  const i = line.indexOf(':');
  return { day: line.slice(0, i), time: line.slice(i + 1).trim() };
};
const hours = site.fallbackHours.map(splitHour);
const events = [
  { title: 'Match en direct', line: 'Tous les grands matchs sur écran', img: 'jersey', alt: 'Maillot des Wallabies signé, encadré au mur' },
  { title: 'Quiz night', line: 'Par équipes, en anglais et en français', img: 'crowd', alt: 'Clients attablés autour de pintes' },
  { title: 'Tournoi de fléchettes', line: 'Inscription au comptoir', img: 'darts-player', alt: 'Un joueur vise la cible de fléchettes' },
  { title: 'Concert', line: '[ARTISTE]', img: 'interior', alt: 'La salle, ses fanions et son lustre' },
];
const booking = site.bookingUrl || '#infos';
// Placeholder gallery from the 2025 photo shoot, until the Instagram sync replaces it.
const gallery = [
  { img: 'cheers', alt: 'Trois pintes La Canaulaise qui trinquent' },
  { img: 'espresso-martini', alt: 'Trois espresso martinis' },
  { img: 'back-bar', alt: 'Le bar et ses carafes à l’étiquette pomme dorée' },
  { img: 'darts-board', alt: 'Les cibles de fléchettes éclairées' },
  { img: 'crowd', alt: 'Clients attablés autour de pintes' },
  { img: 'interior', alt: 'La salle, ses fanions et son lustre' },
];
---
<Base title="The Golden Apple — pub et bières artisanales, Bordeaux depuis 1989" description="Le plus ancien pub de Bordeaux : bières La Canaulaise à la pression, cuisine de pub maison, sport en direct, quiz et fléchettes. 46 rue Borie, Chartrons.">
    <section id="top" class="hero">
      <div class="wrap">
        <div class="hero-text">
          <img src="/img/logo-gold.png" alt="The Golden Apple, Les Brasseurs de l'Océan, est. 1989" width="158" height="216" />
          <h1>Le plus ancien pub de Bordeaux</h1>
          <p>Bières artisanales de La Canaulaise, cuisine de pub maison, sport en direct, quiz et fléchettes. Rue Borie, depuis 1989.</p>
          <div class="hero-actions">
            <a class="btn btn-brass" href={booking}>Réserver une table</a>
            <a class="btn btn-ghost" href="#carte">Voir la carte</a>
            <a class="btn btn-ghost" href="/privatisation">Privatiser le pub</a>
          </div>
        </div>
        <img class="hero-photo" src="/img/photos/facade.webp" alt="La façade verte du Golden Apple, rue Borie, le soir" width="1200" height="1500" fetchpriority="high" />
      </div>
    </section>

    <section id="ce-soir" class="tonight" aria-label="Ce soir">
      <div class="wrap">
        <div class="item">
          <span class="label">Maintenant</span>
          <span class="value"><span class="dot" id="status-dot" aria-hidden="true"></span><span id="status-text">Horaires ci-dessous</span></span>
        </div>
        <div class="item">
          <span class="label">Happy hour</span>
          <span class="value" id="happy-hour">—</span>
        </div>
        <div class="item">
          <span class="label">Ce soir</span>
          <span class="value">[ÉVÉNEMENT DU JOUR]</span>
        </div>
        <div class="item">
          <span class="label">À la pression</span>
          <a class="value" href="#pression">{beers.length} pressions →</a>
        </div>
      </div>
    </section>

    <section id="pression" class="section">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2>À la pression</h2>
            <p>Nos bières La Canaulaise, brassées à Lacanau, et un cidre. Prix TTC.</p>
          </div>
        </div>
        <div class="beers">
          {beers.map((b) => (
            <article class="beer">
              <h3>{b.name}</h3>
              <span class="style">{b.style}</span>
              {b.abv && <span class="meta">{fmtAbv(b.abv)}</span>}
              <dl class="prices">
                <div><dt>½ pinte</dt><dd>{eur(b.prices.demi)}</dd></div>
                <div><dt>Pinte</dt><dd>{eur(b.prices.pinte)}</dd></div>
                {b.prices.pichet && <div><dt>Pichet 1,5 L</dt><dd>{eur(b.prices.pichet)}</dd></div>}
              </dl>
              {b.prices.pinteHH && <span class="hh">Happy hour : pinte à {eur(b.prices.pinteHH)}</span>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="carte" class="section food">
      <div class="wrap split">
        <img class="food-photo" src="/img/photos/food.webp" alt="Beignets maison et frites sur une table en bois" width="1000" height="800" loading="lazy" />
        <div class="food-text">
          <h2>Cuisine de pub maison</h2>
          <p>Des plats faits maison, pensés pour aller avec nos bières. La carte en ligne est la même qu'au comptoir, prix compris.</p>
          <span><strong>Cuisine :</strong> <span id="kitchen-hours">—</span></span>
          <a class="btn btn-green" href="#carte">Voir la carte complète</a>
        </div>
      </div>
    </section>

    <section id="evenements" class="section events">
      <div class="wrap">
        <div class="section-head">
          <h2>Événements</h2>
          
        </div>
        <div class="event-grid">
          {events.map((e) => (
            <article class="event">
              <img src={`/img/photos/${e.img}-card.webp`} alt={e.alt} width="640" height="400" loading="lazy" />
              <div class="event-body">
                <span class="event-date">[DATE] · [HEURE]</span>
                <h3>{e.title}</h3>
                <p>{e.line}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" aria-label="Instagram">
      <div class="wrap">
        <div class="section-head">
          <h2>Au pub, cette semaine</h2>
          <a href={site.instagramUrl || '#'}>Suivez-nous sur Instagram →</a>
        </div>
        <div class="insta-grid">
          {gallery.map((g) => (
            <img src={`/img/photos/${g.img}-sq.webp`} alt={g.alt} width="500" height="500" loading="lazy" />
          ))}
        </div>
      </div>
    </section>

    <section id="infos" class="section visit">
      <div class="wrap split">
        <div>
          <h2>Nous trouver</h2>
          <div class="contact">
            <span>{site.address}</span>
            <a href={`tel:${site.phoneIntl}`}><strong>{site.phone}</strong></a>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </div>
          <table class="hours">
            <caption class="label">Horaires</caption>
            <tbody id="hours-body">
              {hours.map((h) => (
                <tr><th scope="row">{h.day}</th><td>{h.time}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="hours-extra" id="hours-extra"></p>
        </div>
        <a class="map placeholder" href={site.mapsUrl} target="_blank" rel="noopener">Ouvrir dans Google Maps : 46 rue Borie, Chartrons</a>
      </div>
    </section>

    <section class="newsletter" aria-label="Newsletter">
      <form class="wrap" onsubmit="return false">
        <div class="intro">
          <h2>Les soirées à venir, dans votre boîte mail</h2>
          <span>Un e-mail par mois, pas plus.</span>
        </div>
        <div class="fields">
          <label>Votre e-mail
            <input type="email" name="email" placeholder="vous@exemple.fr" autocomplete="email" />
          </label>
          <button type="submit">S'inscrire</button>
        </div>
      </form>
    </section>
  <script slot="scripts">
    const parisDay = () => {
      const name = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', timeZone: 'Europe/Paris' }).format(new Date());
      return name.toLowerCase();
    };
    const split = (line: string) => {
      const i = line.indexOf(':');
      return { day: line.slice(0, i).trim().toLowerCase(), time: line.slice(i + 1).trim() };
    };
    const short = (t: string) => t.replace(/:00/g, 'h').replace(/:(\d\d)/g, 'h$1');

    fetch('/api/hours')
      .then((r) => r.json())
      .then((d) => {
        if (d.error) return;
        const lines: string[] = d.thisWeek?.length ? d.thisWeek : d.opening;
        const today = parisDay();
        const body = document.getElementById('hours-body')!;
        body.textContent = '';
        let todayTime = '';
        lines.map(split).forEach((h) => {
          const tr = document.createElement('tr');
          if (h.day === today) { tr.className = 'today'; todayTime = h.time; }
          const th = document.createElement('th'); th.scope = 'row'; th.textContent = h.day;
          const td = document.createElement('td'); td.textContent = h.time;
          tr.append(th, td); body.appendChild(tr);
        });

        const dot = document.getElementById('status-dot')!;
        const text = document.getElementById('status-text')!;
        const [open, close] = todayTime.split('–').map((s) => s.trim());
        if (d.openNow === true) {
          dot.className = 'dot open';
          text.textContent = close ? `Ouvert jusqu'à ${short(close)}` : 'Ouvert';
        } else if (d.openNow === false) {
          dot.className = 'dot closed';
          text.textContent = open && /\d/.test(open) ? `Fermé · ouvre à ${short(open)}` : 'Fermé aujourd’hui';
        }

        if (d.happyHour?.length) document.getElementById('happy-hour')!.textContent = d.happyHour.join(' · ');
        if (d.kitchen?.length) document.getElementById('kitchen-hours')!.textContent = d.kitchen.join(' · ');
      })
      .catch(() => {});
  </script>
</Base>
