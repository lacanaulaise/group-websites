---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---
<Base title="La carte — The Golden Apple, pub à Bordeaux" description="La carte du Golden Apple : burgers maison, tapas, bières La Canaulaise à la pression, cocktails, vins et softs. Prix TTC.">
  <section class="hero carte-hero">
    <div class="wrap">
      <div class="hero-text">
        <span class="label" style="color: var(--brass)">La carte</span>
        <h1>À manger, à boire</h1>
        <p>Les mêmes plats et les mêmes prix qu'au comptoir. Prix TTC, service compris.</p>
        <nav class="carte-jump" aria-label="Aller à">
          <a class="btn btn-brass" href="#a-manger">À manger</a>
          <a class="btn btn-ghost" href="#a-boire">À boire</a>
        </nav>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div id="carte-root" aria-live="polite">
        <p class="lead">Chargement de la carte…</p>
      </div>
      <noscript>
        <p class="lead">La carte s'affiche avec JavaScript. Vous pouvez aussi nous appeler au {site.phone}.</p>
      </noscript>
    </div>
  </section>

  <script is:inline slot="scripts">
    const root = document.getElementById('carte-root');
    const eur = (n) => (Number.isInteger(n) ? String(n) : n.toFixed(2).replace('.', ',')) + ' €';
    const el = (tag, cls, text) => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text != null) e.textContent = text;
      return e;
    };

            
    function renderGroup(id, heading, sections) {
      if (!sections.length) return;
      const group = el('div', 'carte-group');
      group.id = id;
      group.appendChild(el('h2', '', heading));
      for (const s of sections) {
        const block = el('section', 'carte-section');
        block.appendChild(el('h3', '', s.title));
        const list = el('ul', 'carte-list');
        for (const it of s.items) {
          const li = el('li', 'carte-item');
          const head = el('div', 'carte-line');
          head.appendChild(el('span', 'carte-name', it.name));
          head.appendChild(el('span', 'carte-dots'));
          const prices = el('span', 'carte-prices');
          for (const p of it.prices) {
            const pe = el('span', 'carte-price');
            if (p.format) pe.appendChild(el('small', '', p.format + ' '));
            pe.appendChild(document.createTextNode(eur(p.price)));
            prices.appendChild(pe);
          }
          head.appendChild(prices);
          li.appendChild(head);
          if (it.desc) li.appendChild(el('p', 'carte-desc', it.desc));
          const hh = it.prices.filter((p) => p.hh != null && p.hh < p.price);
          if (hh.length) {
            li.appendChild(el('p', 'carte-hh', 'Happy hour : ' + hh.map((p) => (p.format ? p.format + ' ' : '') + eur(p.hh)).join(' · ')));
          }
          list.appendChild(li);
        }
        block.appendChild(list);
        group.appendChild(block);
      }
      root.appendChild(group);
    }

    fetch('/api/carte')
      .then((r) => r.json())
      .then((d) => {
        if (d.error || !d.sections?.length) throw new Error(d.error || 'empty');
        root.textContent = '';
        renderGroup('a-manger', 'À manger', d.sections.filter((s) => s.food));
        renderGroup('a-boire', 'À boire', d.sections.filter((s) => !s.food));
        if (location.hash) document.querySelector(location.hash)?.scrollIntoView();
      })
      .catch(() => {
        root.innerHTML = '';
        root.appendChild(el('p', 'lead', 'La carte est momentanément indisponible. Appelez-nous au 05 56 79 03 85.'));
      });
  </script>
</Base>
