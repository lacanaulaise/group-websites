{
  // Golden Apple site — static assets plus a small Worker for live data under /api/.
  // Secrets (Cloudflare dashboard, never in this repo): GOOGLE_PLACES_KEY, FORM_RELAY_URL, FORM_RELAY_SECRET
  // Secrets: META_TOKEN or IG_ACCESS_TOKEN (Facebook token: Page events), IG_LOGIN_TOKEN (Instagram Login)
  // KV binding (dashboard): STATE — keeps the renewed Instagram token
  "name": "golden-apple",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  // Keep the plain-text variables set in the Cloudflare dashboard (CARTE_CSV_URL, IG_USER_ID)
  // when deploying from GitHub; without this, a deploy can remove them.
  "keep_vars": true,
  // Public, non-secret settings live here (secrets stay in the Cloudflare dashboard).
  "vars": {
    // Instagram account shown on the site, read through L'Australien's Instagram account
    "IG_HANDLE": "goldenapplepub",
    "IG_USER_ID": "17841465274001610",
    "IG_VIA_ID": "17841466753382868",
    // "Carte site web" Sheet, tab GOLDEN APPLE, published as CSV (written daily from the Monora till)
    "CARTE_CSV_URL": "https://docs.google.com/spreadsheets/d/e/2PACX-1vRRO1Z3SSvCM-4lIhzsdQXXCctkZupkQyUnrP6VwTyesFzqKSC5zBCF8DbWGAXPZXonURsmIVvRzE_-/pub?gid=774036668&single=true&output=csv"
  },
  // Weekly (Monday 04:00 UTC): renew the Instagram token.
  "triggers": { "crons": ["0 4 * * 1"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
