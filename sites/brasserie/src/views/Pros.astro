---
import Base from '../layouts/Base.astro';
import { T } from '../i18n.js';

interface Props { lang: 'fr' | 'en'; }
const { lang } = Astro.props;
const t = T[lang];
const p = t.pros;
const f = t.form;
---
<Base page="/pros" lang={lang} title={p.title} description={p.description}>
  <section class="page-hero">
    <div class="wrap">
      <div class="text">
        <span class="label">CHR · cavistes · épiceries</span>
        <h1>{p.h1}</h1>
        <p>{p.intro}</p>
        <a class="btn btn-brass" href="#partenaire">{p.formTitle}</a>
      </div>
      <img src="/img/photos/brewhouse.webp" alt="" width="1000" height="800" />
    </div>
  </section>

  <section class="section">
    <div class="wrap cards3">
      {p.points.map(([a, b]) => <div class="card"><h3>{a}</h3><p>{b}</p></div>)}
    </div>
  </section>

  <section class="section form-section" id="partenaire">
    <div class="wrap">
      <h2>{p.formTitle}</h2>
      <p class="lead">{p.formIntro}</p>
      <p class="req">{f.required}</p>
      <form class="priv-form" data-form="pro" action="/api/demande" data-ok={f.ok} data-fail={f.fail} data-sending={f.sending}>
        <input type="hidden" name="kind" value="pro" />
        <input type="hidden" name="lang" value={lang} />
        <label>{p.company} *<input name="company" required autocomplete="organization" /></label>
        <label>{p.city} *<input name="city" required /></label>
        <label>{p.type}<select name="type">{p.typeOptions.map((o) => <option>{o}</option>)}</select></label>
        <label>{p.interest}<select name="interest">{p.interestOptions.map((o) => <option>{o}</option>)}</select></label>
        <label>{f.name} *<input name="name" required autocomplete="name" /></label>
        <label>{f.email} *<input type="email" name="email" required autocomplete="email" /></label>
        <label>{f.phone}<input type="tel" name="phone" autocomplete="tel" /></label>
        <label class="full">{f.message}<textarea name="message" rows="4"></textarea></label>
        <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="form-actions full">
          <button type="submit">{f.send}</button>
          <p class="form-note">{f.privacy}</p>
          <p class="form-status" role="status"></p>
        </div>
      </form>
    </div>
  </section>
</Base>
